# Copia este archivo como .env y completa los valores. Nunca subas .env a git.

# --- Servidor ---
GUILD_ID=                 # ID del servidor de Discord
OWNER_ID=                 # Tu ID de usuario (Owner: mismos permisos que Admin/Mod, sin depender de roles)
MOD_ROLE_IDS=             # IDs de roles con permisos de Admin/Mod, separados por coma (opcional)

# --- Bot controlador (registra y recibe los slash commands) ---
CONTROLLER_TOKEN=
CONTROLLER_CLIENT_ID=

# --- Workers de voz (uno por canal simultáneo) ---
WORKER_1_TOKEN=
WORKER_2_TOKEN=
WORKER_3_TOKEN=

# --- Rutas ---
DATA_DIR=./data           # En producción: /data
YTDLP_PATH=./bin/yt-dlp   # Binario standalone de yt-dlp

# --- Operación ---
LOG_LEVEL=info            # debug | info | warn | error
