{
  "name": "discord-bot-music",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de música privado para Discord: 1 controlador + 3 workers de voz, colas aisladas por canal y playlists en SQLite.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env --max-old-space-size=320 src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "deploy:commands": "node --env-file=.env scripts/deploy-commands.js",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "backup": "node --env-file=.env scripts/backup.js"
  },
  "dependencies": {}
}
